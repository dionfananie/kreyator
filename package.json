{
	"name": "kreyator",
	"description": "Kreyator — React Router 7 on Cloudflare Workers, built with Rsbuild.",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rsbuild build",
		"dev": "NODE_OPTIONS=--experimental-vm-modules node server/rsbuild-dev.mjs",
		"preview": "npm run build && wrangler dev --port 8787",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc -b",
		"check": "tsc -b && rsbuild build && wrangler deploy --dry-run",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"isbot": "5.1.32",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-router": "7.18.5",
		"@react-router/express": "7.18.5",
		"express": "5.1.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261117.1",
		"@react-router/dev": "7.18.5",
		"@rsbuild/core": "^2.2.8",
		"@rsbuild/plugin-react": "^2.1.0",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"rsbuild-plugin-react-router": "^0.8.2",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"wrangler": "^4.136.1",
		"@tailwindcss/postcss": "^4.1.17",
		"postcss": "^8.5.6"
	}
}
